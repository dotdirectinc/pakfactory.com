# ─────────────────────────────────────────────────────────────────────────────
# apps/blog/.env.example — copy to apps/blog/.env.local (gitignored).
#
# blog-ONLY overrides. next.config.ts merges the ROOT .env.local with this file:
# this file WINS, root fills the gaps. So only put a key here when it is
# genuinely blog-specific — a copy of a root value silently shadows root, which
# is the usual reason `pnpm env:staging` looks like it did nothing.
#
# Everything shared (Sanity project/dataset/tokens, backend env) comes from the
# root file — see ../../.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Dev server port (matches the `dev` script in package.json).
# When introducing a new var, also add it to `turbo.json` `@pakfactory/blog#build` env list.

PORT="3003"

# The blog's OWN origin — scheme + host, no path. Used for canonical + OG URLs
# and JSON-LD. This must stay here and NOT move to root: www reads the same key
# name, so a root value would give www the blog's origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3003"

# Subpath hosting (PROD-1596). "" serves the blog at the origin root; "/blog"
# serves it under a subpath and must match `basePath` in next.config.ts.
NEXT_PUBLIC_BLOG_BASE_PATH=""

# Rewritten in place by `pnpm studio:local|staging|prod`. Keep the lines even if
# they match root — the script SKIPS a key whose line is absent, so deleting
# them silently breaks the switch for this app.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
NEXT_PUBLIC_SANITY_DATASET="development"

# Algolia — BROWSER side (search-only key, safe to expose). The server-side
# write credentials live at the repo root.
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_API_KEY=""

# Shared secret for the Sanity → /api/revalidate webhook.
SANITY_REVALIDATE_SECRET=""

# "1" sends X-Robots-Tag: noindex — keep set on every non-production blog.
BLOG_DISABLE_INDEXING="1"

# Newsletter + contributor-pitch email delivery.
SMTP_USER=""
SMTP_PASS=""

# ─── Carried over from www-new-release's .env.example: blog webhooks ─────────
# Live on the pakfactory-blog project (NEWSLETTER_WEBHOOK_URL is stored Secret).
NEWSLETTER_WEBHOOK_URL=""
NEXT_PUBLIC_NEWSLETTER_WEBHOOK_URL=""
CONTRIBUTE_WEBHOOK_URL=""
NEXT_PUBLIC_CONTRIBUTE_WEBHOOK_URL=""
