# Admin app — local overrides (port 4000).
# Supabase credentials and NEXT_PUBLIC_WWW_URL load from the repo root `.env.local` via next.config.ts.
PORT=4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:4000
# NEXT_PUBLIC_WWW_URL=http://localhost:3003 — forgot-password, sign-up, and policy links on login (www dev port)

# Data source. `mock` (default) reads the allowlist + fixtures below.
# `supabase` reads public.internal_user and public.rfq under RLS (PROD-2415) —
# the switch is this one variable; no component or adapter code changes.
#
# ⚠️ With `supabase`, a sales member sees only requests whose lead is assigned to
# their crm_owner_id. Nothing populates rfq.assigned_owner_crm_id yet (the
# ADR-0012 D3 assignment webhook is unbuilt), so the list is EMPTY until it does.
# That is the scoping working, not a misconfiguration.
ADMIN_DATA_SOURCE=mock

# Mock internal accounts (ADMIN_DATA_SOURCE=mock only).
# Use a real Supabase auth email you can sign in with.
# Format: email:zohoUserId pairs, comma-separated.
# Mock request fixtures for zoho-user-sales-1 live in packages/domain.
ADMIN_INTERNAL_ACCOUNT_ALLOWLIST=your-real-supabase-email@example.com:zoho-user-sales-1

# Development only — never set in production or on Vercel preview deploys you share.
# Skips Supabase login; opens protected pages directly with mock internal session.
ADMIN_DEV_BYPASS=true
ADMIN_DEV_BYPASS_ZOHO_USER_ID=zoho-user-sales-1
