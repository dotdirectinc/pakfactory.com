# Loaded by `sanity build` / `sanity deploy` (Vite production mode).
# Bundled into the DEPLOYED studio — re-run `pnpm sanity deploy` after changing.
# Public URLs, safe to commit. Names must match sanity.config.ts.

# Blog preview base for the deployed studio's Presentation tool.
# MUST be the non-SSO Vercel origin WITH the `/blog` basePath AND a trailing slash:
#  - `blog.pakfactory.com` 301-strips the path (draft-mode enable never reached)
#  - `pakfactory-blog.vercel.app` is SSO-gated (302 → vercel.com/sso-api)
#  - trailing slash is required so the relative `enable` path resolves under /blog
# See sanity.config.ts (BLOG_PREVIEW_BASE / BLOG_BASE_PATH) — PROD-2223.
SANITY_STUDIO_PREVIEW_URL_BLOG="https://origin.blog.pakfactory.com/blog/"

# WWW: no deployed URL yet — falls back to http://localhost:3000 until one exists.
# SANITY_STUDIO_PREVIEW_URL_WWW="https://www.pakfactory.com"
