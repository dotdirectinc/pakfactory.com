# Loaded by `sanity build` / `sanity deploy` (Vite production mode).
# Bundled into the DEPLOYED studio — re-run `pnpm sanity deploy` after changing.
# Public URLs, safe to commit. Names must match sanity.config.ts.

# Presentation preview BASES for the deployed Studio. Both point at the APEX
# (pakfactory.com), the canonical destination — NOT the Vercel origins, which now
# 307-redirect direct hits to the apex (PROD-2207) and would bounce the Presentation
# iframe off `allowOrigins`. The apex is served by nginx (trusted proxy, no redirect).
# Trailing slash is required so the relative `enable` path resolves under the base.
#  - blog: nginx forwards `^~ /blog` (incl. the enable route) to the blog origin.
#  - www:  nginx forwards `/case-studies*` only, so the enable route lives under
#          `/case-studies/api/draft-mode/enable` (see sanity.config.ts). PROD-2223.
SANITY_STUDIO_PREVIEW_URL_BLOG="https://pakfactory.com/blog/"
SANITY_STUDIO_PREVIEW_URL_WWW="https://pakfactory.com/case-studies/"
