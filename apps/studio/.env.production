# Loaded by `sanity build` / `sanity deploy` (Vite production mode).
# Public URLs, safe to commit. Names must match sanity.config.ts.
#
# FALLBACKS ONLY — these are what a bare `sanity build` gets. Both deploy scripts
# (`pnpm sanity:deploy:prod` / `:staging`) export their whole target from `TARGETS`
# in scripts/sanity/studio-targets.mjs, and shell env outranks every .env file, so
# the values below do not decide what a deployed studio ships. Change a deployed
# studio's preview targets in `TARGETS`, not here.
#
# Note this file OUTRANKS `.env.local` in production mode
# (`shell env > .env.production > .env.local > .env`), which is why the staging
# deploy could not be steered by `pnpm studio:staging` and needed the script.

# Presentation preview BASES for the deployed Studio. Both point at the APEX
# (pakfactory.com), the canonical destination — NOT the Vercel origins, which now
# 307-redirect direct hits to the apex (PROD-2207) and would bounce the Presentation
# iframe off `allowOrigins`. The apex is served by nginx (trusted proxy, no redirect).
# Trailing slash is required so the relative `enable` path resolves under the base.
#  - blog: nginx forwards `^~ /blog` (incl. the enable route) to the blog origin.
#  - www:  nginx forwards `/case-studies*` only, so the enable route lives under
#          `/case-studies/api/draft-mode/enable` (see sanity.config.ts). PROD-2223.
SANITY_STUDIO_PREVIEW_URL_BLOG="https://pakfactory.com/blog/"
SANITY_STUDIO_PREVIEW_URL_WWW="https://pakfactory.com/case-studies/"

# NOTE: SANITY_STUDIO_PREVIEW_URL_SITE is deliberately NOT set here.
# It is exported per target by `scripts/sanity/studio-deploy.mjs` from TARGETS in
# `scripts/sanity/studio-targets.mjs`, because it differs by Studio: the staging
# Studio previews the staging site root, and the production Studio has no site
# root wired until those workspaces are released. Setting it here would apply it
# to BOTH deploys — which is exactly how the production Studio ended up offering
# a pane that always failed with "Invalid secret".
# Dataset for a DEPLOYED studio. Pinned to production so a build that forgets to
# say which dataset it wants cannot silently inherit whatever `.env.local` was left
# on (that file is developer-local and usually sits on `development`).
# Vite gives shell env precedence over every .env file, so the deploy scripts still
# decide: `pnpm sanity:deploy:staging` exports SANITY_STUDIO_DATASET=development and
# that wins over this line. Local `sanity dev` never reads this file (dev mode).
SANITY_STUDIO_DATASET="production"
