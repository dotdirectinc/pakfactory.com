# Copy to apps/studio/.env.local — must match repo root .env.local project + dataset.
# When introducing a new var, also add it to `turbo.json` env lists if apps consume it at build time.
SANITY_STUDIO_PROJECT_ID=""
SANITY_STUDIO_DATASET="development"
# Presentation preview BASES — names must match sanity.config.ts. Trailing slash
# required (the relative `enable` path resolves under the base). The www enable
# route lives under /case-studies (PROD-2223), so the www base carries that path.
# www dev runs on port 3003 (not 3000); blog dev runs on port 3004.
SANITY_STUDIO_PREVIEW_URL_WWW="http://localhost:3003/case-studies/"
SANITY_STUDIO_PREVIEW_URL_BLOG="http://localhost:3004/"
