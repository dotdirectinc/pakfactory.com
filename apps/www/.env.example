# apps/www/.env.local — optional overrides (root .env.local is primary via next.config.ts).
# When introducing a new var, also add it to `turbo.json` `@pakfactory/www#build` env list.
SANITY_REVALIDATE_SECRET=""
WWW_DISABLE_INDEXING=""
WWW_ORIGIN_PROXY_SECRET=""
BACKEND_API_BASE_URL=""
SERVICE_SHARED_SECRET=""
# Prefer repo-root `.env.local` (www force-reloads from the monorepo root).
# Server-only Google Places (New) key — never NEXT_PUBLIC_*. Leave empty to disable autocomplete.
GOOGLE_PLACES_API_KEY=""
# Optional kill switch; omit / leave empty to enable when a key is set. Set "false" to force off.
PLACES_AUTOCOMPLETE_ENABLED=""
NEXT_PUBLIC_BLOG_URL="http://localhost:3004"
NEXT_PUBLIC_WATERMARK_MODE=""
