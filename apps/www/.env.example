# ─────────────────────────────────────────────────────────────────────────────
# apps/www/.env.example — copy to apps/www/.env.local (gitignored).
#
# www-ONLY overrides. next.config.ts merges the ROOT .env.local with this file:
# this file WINS, root fills the gaps. So only put a key here when it is
# genuinely www-specific — a copy of a root value silently shadows root, which
# is the usual reason `pnpm env:staging` looks like it did nothing.
#
# Everything shared (Sanity project/dataset/tokens, Supabase, BACKEND_API,
# Google Places) comes from the root file — see ../../.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Rewritten in place by `pnpm studio:local|staging|prod`. Keep the lines even if
# they match root — the script SKIPS a key whose line is absent, so deleting
# them silently breaks the switch for this app.
# When introducing a new var, also add it to `turbo.json` `@pakfactory/www#build` env list.

NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
NEXT_PUBLIC_SANITY_DATASET="development"

# Where the draft-mode DISABLE route returns the editor to. Overrides root.
SANITY_STUDIO_PREVIEW_URL="http://localhost:3000"

# "true" sends X-Robots-Tag: noindex — keep set on every non-production www.
WWW_DISABLE_INDEXING="true"

# NEXT_PUBLIC_SITE_URL is deliberately NOT set here.
# src/lib/site.ts falls back to https://pakfactory.com, which is what you want
# for local dev and previews. It must also never be set at ROOT: the root value
# is the blog's origin (:3003) and www would inherit it, silently rewriting
# every canonical + OG URL. Set it here only to deliberately override.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Premium shadcn registry auth (the CLI requires these exact names, and reads
# them from the directory it runs in — hence here, not root).
EMAIL=""
LICENSE_KEY=""
