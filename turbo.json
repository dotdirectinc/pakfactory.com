{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_SANITY_PROJECT_ID",
    "NEXT_PUBLIC_SANITY_DATASET",
    "NEXT_PUBLIC_SANITY_API_VERSION",
    "NEXT_PUBLIC_SANITY_STUDIO_URL",
    "SANITY_API_READ_TOKEN",
    "SANITY_API_WRITE_TOKEN",
    "SANITY_STUDIO_PROJECT_ID",
    "SANITY_STUDIO_DATASET",
    "SANITY_STUDIO_PREVIEW_URL",
    "PORT",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_STUDIO_URL",
        "SANITY_API_READ_TOKEN",
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_PREVIEW_URL",
        "NEXT_PUBLIC_SITE_URL",
        "CONTRIBUTE_WEBHOOK_URL",
        "NEXT_PUBLIC_CONTRIBUTE_WEBHOOK_URL",
        "PORT",
        "BACKEND_API_BASE_URL",
        "SERVICE_SHARED_SECRET",
        "WWW_ORIGIN_PROXY_SECRET"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_STUDIO_URL",
        "NEXT_PUBLIC_SITE_URL",
        "SANITY_API_READ_TOKEN",
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_PREVIEW_URL"
      ]
    },
    "@pakfactory/www#build": {
      "dependsOn": [
        "@pakfactory/sanity#typecheck",
        "@pakfactory/ui#typecheck"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_STUDIO_URL",
        "SANITY_STUDIO_URL",
        "NEXT_PUBLIC_SITE_URL",
        "SANITY_API_READ_TOKEN",
        "SANITY_API_WRITE_TOKEN",
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_PREVIEW_URL",
        "SANITY_REVALIDATE_SECRET",
        "VERCEL_ENV",
        "WWW_DISABLE_INDEXING",
        "BACKEND_API_BASE_URL",
        "SERVICE_SHARED_SECRET",
        "WWW_ORIGIN_PROXY_SECRET"
      ]
    },
    "@pakfactory/blog#build": {
      "dependsOn": [
        "@pakfactory/seo#typecheck",
        "@pakfactory/sanity#typecheck",
        "@pakfactory/ui#typecheck"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_STUDIO_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_BLOG_BASE_PATH",
        "SANITY_API_READ_TOKEN",
        "SANITY_API_WRITE_TOKEN",
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_PREVIEW_URL",
        "SANITY_REVALIDATE_SECRET",
        "CONTRIBUTE_WEBHOOK_URL",
        "NEXT_PUBLIC_CONTRIBUTE_WEBHOOK_URL"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
