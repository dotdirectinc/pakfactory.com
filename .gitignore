# Dependencies
node_modules

# Next.js
.next
out
next-env.d.ts

# Build
dist

# Turbo
.turbo

# Environment
# Committed:  .env.example (every app)  ·  apps/studio/.env.production (public URLs only)
# Never:      anything below. See README § Environment files.
.env
.env.local
.env.*.local
# Backups written by `pnpm env:staging` / `env:prod` (scripts/env/switch-env.mjs).
# These are verbatim copies of .env.local — secrets and all — and were NOT matched
# by the patterns above, so `git add -A` would have committed them.
.env.local.bak-*
.env*.bak
.env*.bak-*

# TypeScript
*.tsbuildinfo

# Sanity
sanity.schema.json
.sanity/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
!.vscode/settings.json

# Lockfiles — pnpm is the package manager for this monorepo.
# The root pnpm-lock.yaml MUST be committed; npm/yarn lockfiles are never allowed
# (applies in every dir, so this also ignores apps/*/package-lock.json).
package-lock.json
yarn.lock

.claude/training/*
docs/*
!docs/ai-agent-docs.md

apps/studio/backup
backups/