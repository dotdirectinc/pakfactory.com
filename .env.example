# ─────────────────────────────────────────────────────────────────────────────
# ROOT .env.example — copy to `.env.local` (gitignored).
#
#     cp .env.example .env.local
#
# SCOPE RULE for this file: a variable belongs here when TWO OR MORE consumers
# need it, or a script does. Anything one app alone reads belongs in that app's
# own `.env.local` — see apps/*/.env.example.
#
# Read by:  apps/www + apps/blog (merged by loadEnvConfig in their
#           next.config.ts — the APP file wins, this fills the gaps)
#           scripts/**  ·  sanity.blueprint.ts  ·  scripts/test-gdrive-*
# NOT read by: apps/studio. Vite only reads apps/studio/, so the Studio
#           repeats what it needs in apps/studio/.env.local.
#
# This file is gitignored once copied, so `.env.local` is shared by EVERY branch
# in the checkout and is NOT inherited by git worktrees (copy it in by hand).
# Keep keys that only one branch uses — the Supabase / BACKEND_API keys below
# are unused on `staging` but load-bearing on `www-new-release` and `admin`.
#
# Full guide: README.md § Environment files
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity: project + dataset (shared by www, blog and the scripts) ──────────
# @see https://www.sanity.io/docs/nextjs/configure-sanity-client-nextjs
# When introducing a new var, also add it to `turbo.json` `globalEnv` / task `env` lists.

NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="development"
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25"
# Studio the Presentation overlays link back to (stega.studioUrl). Moved per app
# by `pnpm studio:local|staging|prod`, which also writes the app-level copies.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
# Studio-style aliases — the apps and packages/sanity fall back to these.
SANITY_STUDIO_PROJECT_ID=""
SANITY_STUDIO_DATASET="development"
# Where the draft-mode DISABLE route sends the editor back to (www + blog).
SANITY_STUDIO_PREVIEW_URL="http://localhost:3333"

# ── Sanity tokens ────────────────────────────────────────────────────────────
# Viewer — enables the `drafts` perspective locally so unpublished docs render.
SANITY_API_READ_TOKEN=""
# Editor — seed scripts and the publishedAt stamp on scheduled publish.
SANITY_API_WRITE_TOKEN=""

# ── Backend environment (Supabase + API) — switched by `pnpm env:staging|prod` ─
# Pattern per variable, and all three lines are required:
#     VAR_PROD=…      canonical production value
#     VAR_STAGING=…   canonical staging value
#     VAR=…           ACTIVE — a copy of one of the above, what the apps read
# `pnpm env:status` reports which set is live (from the `# APP_ENV=` marker) and
# warns when an app-level .env.local shadows the active value.
# Do NOT collapse these into one line: the switch script needs all three.
NEXT_PUBLIC_SUPABASE_URL_PROD=""
NEXT_PUBLIC_SUPABASE_URL_STAGING=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=""
NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGING=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
BACKEND_API_BASE_URL_PROD=""
BACKEND_API_BASE_URL_STAGING="http://localhost:8080"
BACKEND_API_BASE_URL="http://localhost:8080"
SERVICE_SHARED_SECRET_PROD=""
SERVICE_SHARED_SECRET_STAGING=""
SERVICE_SHARED_SECRET=""
# Secret nginx sends when proxying the apex into the www origin.
WWW_ORIGIN_PROXY_SECRET_PROD=""
WWW_ORIGIN_PROXY_SECRET_STAGING=""
WWW_ORIGIN_PROXY_SECRET=""

# ── Google Places (New) — www address autocomplete + solution reviews ────────
# Server-only. Never rename to NEXT_PUBLIC_*; that would ship the key.
GOOGLE_PLACES_API_KEY=""
# Kill switch: "false" keeps autocomplete off even when a key is set.
PLACES_AUTOCOMPLETE_ENABLED="true"
# PakFactory Google Place ID (long-lived). Used by solution Reviews section
# (PROD-2587). Same API key as autocomplete; reviews use a shared 24h cache
# keyed by this ID (independent of page ISR). Find via Place Details or Maps URL.
GOOGLE_PLACES_PLACE_ID=""
# Optional kill switch for live Google reviews ("false" / "0" / "off").
# Default: on when GOOGLE_PLACES_API_KEY + GOOGLE_PLACES_PLACE_ID are set.
# GOOGLE_REVIEWS_ENABLED="true"

# ── Algolia (blog search) — server side ──────────────────────────────────────
# Read by DESTRUCTURING, so `grep process.env.ALGOLIA_*` finds nothing:
# sanity.blueprint.ts (THROWS if unset), functions/algolia-document-sync,
# apps/studio/scripts/algolia-{initial-sync,configure-index}.
# Leave UNSET rather than "" — an empty string passes the blueprint's
# `typeof === "string"` check and deploys the function with empty credentials.
# ALGOLIA_APP_ID=
# ALGOLIA_WRITE_KEY=
# The browser-side pair lives in apps/blog/.env.local (NEXT_PUBLIC_ALGOLIA_*).

# ── Nightly Sanity backup → Google Drive ─────────────────────────────────────
# CI reads these from GitHub Actions secrets (.github/workflows/sanity-backup.yml,
# cron 0 1 * * *). The copies here are what the LOCAL harness uses —
# scripts/test-gdrive-upload.sh and scripts/test-gdrive-api.py source this file.
SANITY_BACKUP_TOKEN=""
SANITY_WRITE_TOKEN=""
GDRIVE_FOLDER_ID=""
GDRIVE_SHARED_DRIVE_ID=""
# Service-account JSON on ONE line, single-quoted. This is a private key: treat
# it like a password, and prefer `GOOGLE_APPLICATION_CREDENTIALS=/path/to.json`
# over pasting it here if your tooling supports it.
GDRIVE_SERVICE_ACCOUNT_JSON=''
# Optional — the backup folder is auto-shared with this address when set.
SHARE_WITH_EMAIL=""

# ── Analytics ────────────────────────────────────────────────────────────────
# No env var: the GTM container ID lives in Sanity Global Settings →
# Integrations (`gtmId`), injected on blog + www only when VERCEL_ENV=production.

# ─── Carried over from www-new-release's .env.example ────────────────────────
# These were documented before the sync and are all live on Vercel today; the
# env-scope restructure did not carry them, so they are parked here rather than
# lost. Re-file any that belong in an app's own file.
NEXT_PUBLIC_BLOG_URL=""        # www → blog cross-links (prod: https://pakfactory.com/blog)
NEXT_PUBLIC_WWW_URL=""         # blog → www; organization entity in JSON-LD
NEXT_PUBLIC_WATERMARK_MODE=""  # image watermarking; set on both Vercel projects
ALGOLIA_SEARCH_KEY=""          # server-side key (NEXT_PUBLIC_ALGOLIA_API_KEY is the public search-only one)
SANITY_STUDIO_URL=""           # legacy fallback for NEXT_PUBLIC_SANITY_STUDIO_URL (stega studioUrl)
# VERCEL_ENV is injected by the platform — reference only, never set it yourself.
